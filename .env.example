# HypeCheck environment variables.
# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Full setup guide: docs/self-hosting.md

# ── Required ────────────────────────────────────────────────────────────────

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only secret. Used to save reports, change credits, verify payments and run /admin.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Claude Console -> API keys. The org must have credit and allow web search.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Public URL of this deployment, no trailing slash. http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Recommended ─────────────────────────────────────────────────────────────

# Comma-separated emails with unlimited reports and access to /admin.
HYPECHECK_ADMIN_EMAILS=you@example.com

# ── Optional: model overrides (defaults are set in code) ────────────────────

# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_JUDGE_MODEL=claude-haiku-5-5

# ── Optional: payments with Dodo Payments ───────────────────────────────────
# Leave unset to run without payments (3 free reports per account; admins unlimited).

# DODO_SECRET_KEY=your_dodo_secret_key
# DODO_WEBHOOK_SECRET=your_dodo_webhook_signing_secret
# DODO_PRODUCT_ID_SINGLE=your_dodo_1_report_product_id
# DODO_PRODUCT_ID_PACK=your_dodo_10_report_product_id
# DODO_ENVIRONMENT=test_mode
